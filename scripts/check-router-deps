#!/usr/bin/env python3
import shutil,sys
commands=['python3','fsck.fat','mcopy','mdir','mtype','lsblk','findmnt','blkid','swapon','mountpoint','umount','sha256sum','tar','gzip']
missing=[name for name in commands if not shutil.which(name)]
if sys.version_info<(3,11):missing.append('Python >=3.11')
if missing:raise SystemExit('Missing: '+', '.join(missing))
print('Operator dependencies present; no device accessed')
