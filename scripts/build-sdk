#!/usr/bin/env python3
import argparse
import os
from pathlib import Path
import sys

parser = argparse.ArgumentParser()
parser.add_argument('--config', choices=('debug', 'release'), default='debug')
args = parser.parse_args()

root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root / 'vendor/microkit'))
os.chdir(root / 'vendor/microkit')
import build_sdk as sdk

sdk.SUPPORTED_BOARDS += (sdk.BoardInfo(
    name='nanopi_r5s', arch=sdk.KernelArch.AARCH64,
    gcc_cpu='cortex-a55', loader_link_address=0x30000000,
    kernel_options={'KernelPlatform': 'rk3568',
                    'KernelCustomDTSOverlay': root / 'microkit/memory-overlay.dts'}),)
sys.argv = [sys.argv[0], '--sel4', str(root / 'vendor/sel4'),
            '--boards', 'nanopi_r5s', '--configs', args.config,
            '--skip-docs', '--skip-tar', '--tool-target-triple',
            'x86_64-unknown-linux-gnu' if os.uname().machine == 'x86_64'
            else 'aarch64-unknown-linux-gnu']
sdk.main()
