#!/usr/bin/env python3
"""Decode one complete B51v1 terminal UART capture. Offsets are decimal, words hexadecimal."""
import argparse
import json
import re
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent))
from b51_status import describe


def decode(lines):
    words = []
    for line in lines:
        if "B51v1 " not in line:
            continue
        row = re.search(r"B51v1 (\d{3})((?: [0-9a-fA-F]{8}){4})\s*$", line)
        if row is None or int(row[1]) != len(words):
            raise ValueError("Malformed, missing or repeated B51 row; supply one boot per log")
        words.extend(int(v, 16) for v in row[2].split())
    return describe(words)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("log", type=Path)
    args = parser.parse_args()
    try:
        print(json.dumps(decode(args.log.read_text(errors="replace").splitlines()), indent=2))
    except ValueError as error:
        parser.exit(1, str(error) + "\n")
